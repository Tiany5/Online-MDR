# ---- Data (never commit; see README for download instructions) ----
*.csv
creditcard.csv
data/
prepared*/
sealed/

# ---- Monte Carlo result caches (regenerated by each script) ----
*.rds
*.RData
*.rda

# ---- Generated output ----
# figures/ is tracked on purpose: it holds the figures compiled into the paper.
# Anything a script writes next to itself is not.
code-semi/**/*.pdf
code-semi/**/*.png
application/**/*.pdf
application/**/*.png
appendix-fdr-comparison/*.pdf
appendix-fdr-comparison/*.png
Rplots.pdf
*.log

# ---- Source tarballs for the pinned package versions ----
env/sources/
*.tar.gz

# ---- R session cruft ----
.Rhistory
.RData
.Rproj.user/
.Renviron
*.Rproj

# ---- Python virtualenvs (if you add preprocessing scripts) ----
.venv/
__pycache__/

# ---- Credentials ----
.kaggle/
kaggle.json
access_token
*.token

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/
